<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Размеры шрифтов -->
    <x:Double x:Key="FontSizeTitle">14</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSmall">11.5</x:Double>
    <x:Double x:Key="FontSizeTiny">10</x:Double>

    <!-- Радиусы скругления -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>

    <!-- Стандартные отступы (Thickness) -->
    <Thickness x:Key="PaddingStandard">12,8</Thickness>
    <Thickness x:Key="PaddingSmall">8,4</Thickness>

</ResourceDictionary>
